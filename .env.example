# bili-fav-summarizer environment variables
# Copy this file to .env and fill in your values (never commit .env!)

# Required for --folder / --all modes
# How to get SESSDATA: log into bilibili.com, open DevTools → Application →
# Cookies → api.bilibili.com, copy the value of the "SESSDATA" cookie.
BILI_SESSDATA=your_sessdata_cookie_value_here

# Optional: enables Claude LLM summarization (falls back to extractive if unset)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
